# Next.js App Environment Configuration
# Secret token for Next.js to authenticate requests to Google Apps Script Web App
APPS_SCRIPT_URL="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"
APPS_SCRIPT_SECRET="your_secure_shared_secret_token_here"

# JWT Secret for Session Cookies
AUTH_SECRET="your_random_jwt_secret_key_minimum_32_characters"

# Base URL (for development vs production)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

